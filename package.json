{
  "name": "vampir-koylu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:relay": "wrangler dev --port 8787 --local",
    "prebuild": "node -e \"try{require('fs').rmSync('dist',{recursive:true,force:true,maxRetries:5,retryDelay:200})}catch(e){console.warn('dist temizlenemedi:',e.code)}\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:strings": "node scripts/check-hardcoded-strings.mjs",
    "check": "npm run lint:strings && npm run test && npm run build && npm run lint:build",
    "lint:build": "node scripts/check-build.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@trystero-p2p/mqtt": "^0.25.3",
    "@trystero-p2p/nostr": "^0.25.3",
    "@trystero-p2p/torrent": "^0.25.3",
    "howler": "^2.2.4",
    "i18next": "^23.15.1",
    "i18next-browser-languagedetector": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.0.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@cloudflare/workers-types": "^5.20260823.1",
    "@types/howler": "^2.2.11",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.1",
    "wrangler": "^4.125.0"
  }
}
