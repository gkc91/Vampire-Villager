<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	Gizlilik manifesti. Apple 2024'ten beri zorunlu tutuyor; olmadan
	App Store Connect yüklemeyi reddediyor.

	Burası YALNIZ BU UYGULAMANIN kendi davranışını beyan eder. Google
	Mobile Ads ve diğer SDK'lar kendi manifestlerini taşıyor, Apple
	hepsini birleştiriyor. O yüzden buraya SDK'ların topladığı her şeyi
	yazmıyoruz — yalnız bizim kodumuzun yaptığını.

	App Store'daki "Gizlilik" etiketleriyle ÇELİŞMEMELİ. Çelişki, hem
	ret hem de sonradan uyarı sebebi.
-->
<plist version="1.0">
<dict>
	<!--
		ÜST DÜZEY NSPrivacyTracking ve NSPrivacyTrackingDomains BİLEREK YOK.

		İlk sürümde NSPrivacyTracking = true ve boş bir alan adı listesi
		vardı. Apple derlemeyi ITMS-91064 ile geri çevirdi: izleme bayrağı
		true ise alan adı listesi dolu olmalı (ve tersi).

		Alan adı yazmak çözüm değil: iOS 17+ ATT'ye "hayır" diyen
		kullanıcıda listedeki alan adlarına bağlantıyı KESİYOR. Google'ın
		reklam alan adlarını buraya yazmak, kişiselleştirilmemiş reklamları
		bile o kullanıcıların çoğunda öldürürdü.

		Google Mobile Ads'in kendi manifesti de aynen böyle: üst düzey
		izleme anahtarı yok, izleme VERİ TÜRÜ düzeyinde beyan ediliyor
		(Device ID, Tracking = true). Aşağıdaki DeviceID girdisi aynısını
		yapıyor. App Store'daki gizlilik etiketi "Used to Track You"
		demeye devam ediyor ve ATT izni yine isteniyor — beyan değişmedi,
		yalnız biçimi Apple'ın doğrulayıcısına uydu.
	-->

	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<!--
				Cihaz kimliği: reklam gösterimi için. Kişiye BAĞLI DEĞİL —
				oyunda hesap, giriş, e-posta ya da isim kaydı yok; takma ad
				yalnız o oyun boyunca yaşıyor ve hiçbir yere yazılmıyor.
			-->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<true/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeThirdPartyAdvertising</string>
			</array>
		</dict>
	</array>

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!--
				UserDefaults: Capacitor'ın WebView katmanı ve oyunun kendi
				yerel ayarları (dil, ses, oyuncu jetonu) buradan geçiyor.
				CA92.1 = yalnız uygulamanın KENDİ verisine erişim; başka
				uygulamayla paylaşılmıyor, cihaz parmak izi için
				kullanılmıyor.
			-->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
