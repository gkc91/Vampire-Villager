# Bu dosyayı `.env` olarak kopyalayıp değerleri doldur. `.env` git'e girmez.

# Sinyalleşme yöntemi: nostr (varsayılan) | torrent | mqtt
# Gerçek cihazda sorun yaşarsan diğerlerini deneyip karşılaştır.
# Ölçüm (aynı makine, iki sekme): nostr ~1 sn, torrent ~17 sn.
VITE_P2P_STRATEGY=nostr

# TURN (aktarıcı) sunucusu — mobil operatör ağları (CGNAT) için gerekir.
# Tanımlanmazsa yalnız STUN kullanılır; WiFi'da genelde yeter, mobil veride
# çoğu zaman yetmez. Hesapsız/ücretsiz kamuya açık TURN artık YOK
# (openrelay.metered.ca ölçüldü: çalışmıyor).
# VITE_TURN_URLS=turn:ornek.com:3478,turns:ornek.com:5349
# VITE_TURN_USERNAME=kullanici
# VITE_TURN_CREDENTIAL=parola
