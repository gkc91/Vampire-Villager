{
  // Cloudflare Workers: statik site + oda aktarıcısı (Durable Object).
  // Derleme: npm run build   Yayın: npx wrangler deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vampire-villager",
  "main": "worker/index.ts",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // SPA: bilinmeyen yol (ör. /join/ABC123) index.html'e düşer.
    "not_found_handling": "single-page-application",
    // /room/* WebSocket yükseltmesi ve /probe/* ölçüm uçları Worker'a
    // gitmeli, statik dosyaya değil. Aksi halde SPA yedeği devreye girip
    // 200 + index.html dönüyor ve ölçüm "engelli" sanıyor.
    "run_worker_first": ["/room/*", "/stream/*", "/send/*", "/probe/*"]
  },
  // Worker günlükleri. Kapalıyken console.log çıktısı hiçbir yere düşmez ve
  // panelde "No events found" görünür. Panelden elle açılabilir ama bir
  // sonraki yayında geri kapanabilir; kalıcı yeri burasıdır.
  // Ücretsiz planda günde 200.000 olay; yalnız yaşam döngüsü olayları
  // yazdığımız için bu sınıra yaklaşmak zor.
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }]
  },
  "migrations": [
    // Ücretsiz planda yalnız SQLite destekli Durable Object kullanılabilir.
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] }
  ]
}
