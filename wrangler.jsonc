{
  // Cloudflare Workers: statik site + oda aktarıcısı (Durable Object).
  // Derleme: npm run build   Yayın: npx wrangler deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vampire-villager",
  "main": "worker/index.ts",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // SPA: bilinmeyen yol (ör. /join/ABC123) index.html'e düşer.
    "not_found_handling": "single-page-application",
    // /room/* WebSocket yükseltmesi Worker'a gitmeli, statik dosyaya değil.
    "run_worker_first": ["/room/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }]
  },
  "migrations": [
    // Ücretsiz planda yalnız SQLite destekli Durable Object kullanılabilir.
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] }
  ]
}
