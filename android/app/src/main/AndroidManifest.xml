<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!--
            AdMob uygulama kimliği. Bu meta-data OLMADAN uygulama açılışta
            çöküyor (SDK'nın kendi kontrolü).

            Bu GERÇEK kimlik ve her derlemede burada duruyor. Tehlikesiz:
            uygulama kimliği yalnız uygulamayı tanıtıyor, hangi reklamın
            geleceğini reklam BİRİMİ kimlikleri belirliyor. Onlar da
            varsayılan olarak demo (bkz. src/monetization/adUnits.ts), yani
            geliştirmede ve testte canlı reklam çıkmıyor.

            Sürüme göre değiştirilmiyor olması bilinçli: yayın günü
            "manifest'i güncellemeyi unuttum" diye bir hata kalmasın.
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3566083608754052~3903512524" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                DERİN LİNK: paylaşılan davet uygulamada açılsın.

                Bu iki süzgeç EKSİKTİ; WhatsApp'tan gelen `/join/KOD`
                bağlantısı hep tarayıcıya düşüyordu. Android bir adresi
                uygulamaya yönlendirmeden önce uygulamanın o alan adını
                sahiplendiğini bilmek zorunda ve bunu yalnız manifest'ten
                öğreniyor.

                autoVerify="true": Android kurulumda
                https://biteclub.lampwickgames.com/.well-known/assetlinks.json
                dosyasını indirip imza parmak izini karşılaştırıyor. Eşleşirse
                bağlantı SORMADAN uygulamada açılıyor. Dosya yoksa ya da parmak
                izi tutmazsa sessizce tarayıcıda açılıyor — kullanıcı için
                bugünküyle aynı davranış, yani bozulma riski yok.

                pathPrefix="/join": yalnız davet adresleri. Ana sayfa,
                gizlilik ve nasıl oynanır sayfaları tarayıcıda kalmalı.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                    android:host="biteclub.lampwickgames.com"
                    android:pathPrefix="/join" />
            </intent-filter>

            <!-- Özel şema: QR/uygulama içi paylaşımlar ve yerel test için. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vampirkoylu" android:host="join" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
