<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!--
            AdMob uygulama kimliği. Bu meta-data OLMADAN uygulama açılışta
            çöküyor (SDK'nın kendi kontrolü).

            Bu GERÇEK kimlik ve her derlemede burada duruyor. Tehlikesiz:
            uygulama kimliği yalnız uygulamayı tanıtıyor, hangi reklamın
            geleceğini reklam BİRİMİ kimlikleri belirliyor. Onlar da
            varsayılan olarak demo (bkz. src/monetization/adUnits.ts), yani
            geliştirmede ve testte canlı reklam çıkmıyor.

            Sürüme göre değiştirilmiyor olması bilinçli: yayın günü
            "manifest'i güncellemeyi unuttum" diye bir hata kalmasın.
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3566083608754052~3903512524" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
