# Üretim derlemesi — GİT'E GİRER, yereldeki .env dosyalarını EZER.
#
# Neden var: `.env` her modda okunuyor. Aktarıcıyı yerelde geliştirirken
# oraya yazdığım VITE_RELAY_URL=ws://localhost:8787 üretim paketine gömüldü
# ve yayındaki oyun telefonun kendi localhost'una bağlanmaya çalıştı; iki
# telefon hiçbir şekilde birbirini bulamadı. Yerel ayarlar artık
# `.env.development` içinde, burası da onları kesin olarak eziyor.
#
# Boş bırakılan VITE_RELAY_URL "aktarıcıyı site ile aynı adreste ara"
# demektir — Cloudflare Worker hem statik dosyaları hem /room/* soketini
# aynı origin'den veriyor.
VITE_NET_MODE=relay
VITE_RELAY_URL=

# Uygulamanın içinde origin https://localhost olur (Capacitor WebView).
# Paylaşılan katılma linki bu adresi kullanır.
VITE_PUBLIC_URL=https://biteclub.lampwickgames.com

# AdMob reklam birimleri. BOŞ BIRAKILIRSA Google'ın demo birimleri
# kullanılır (src/monetization/adUnits.ts) — geliştirmede istediğimiz bu.
# Gerçek kimlikleri yalnız yayın derlemesine koy; kendi canlı reklamına
# tıklamak AdMob'da hesap kapatma sebebi.
VITE_ADMOB_INTERSTITIAL=
VITE_ADMOB_REWARDED=
